    "react": "^18",
    "react-dom": "^18",
    "recharts": "3.10.1",
    "tailwind-merge": "2.6.1",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv": "18.0.9",
