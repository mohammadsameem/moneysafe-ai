# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Supabase Postgres) ---
# In Supabase: Project > Connect. Use the pooler strings, not the "Direct connection" one
# (the db.PROJECT_REF.supabase.co host is IPv6-only and fails on many networks and on Vercel).
# Runtime (the app): the "Transaction pooler" string, port 6543.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations only (drizzle-kit): the "Session pooler" string, port 5432.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- LLM (any OpenAI-compatible chat-completions API; all optional) ---
# Leave LLM_API_KEY empty to run without an LLM: every AI feature then uses its rule-based result.
# Free tier: keep LLM_DAILY_CAP below your provider's own daily request limit.
#
# Primary provider: Groq (free plan), which answered fastest in testing. Get a key at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
#
# Second provider: OFF by default and left commented out. It is tried once if the primary errors, times out
# or returns 429, only when LLM_FALLBACK_API_KEY is set (and never if LLM_API_KEY is empty). We have not
# verified a live second provider (the one we tried timed out), so none is recommended.
# Each provider gets at most 8 seconds per call (the pinned attempt and its JSON retry share that time).
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_MODEL=

# --- Behaviour ---
# true = every PayPal write is simulated (still requires an approval record).
DEMO_MODE=false
# Assumptions used by the contest-vs-refund expected-value rule and the dashboard.
CHARGEBACK_FEE_USD=20
CONTEST_EFFORT_USD=10
# Global cap on LLM calls per UTC day. Over the cap, the app returns rule-based results.
LLM_DAILY_CAP=200

# --- Auth (single-merchant demo login) ---
# The demo account is public by design: the login page shows this password. Do not reuse a real one.
DEMO_PASSWORD=change-me
# Generate with: openssl rand -base64 32   (or any random 16+ character string)
NEXTAUTH_SECRET=
# The public URL of the app. PayPal's return/cancel links are built from it. On Vercel: https://<project>.vercel.app
NEXTAUTH_URL=http://localhost:3000
