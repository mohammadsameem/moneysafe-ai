# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Supabase Postgres) ---
# Runtime: the POOLED connection string (Supabase "Transaction pooler", port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations only (drizzle-kit): the DIRECT connection string, port 5432.
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Anthropic ---
# Set a monthly spend limit in the Anthropic Console before deploying ($10-$20 is plenty for a demo).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Behaviour ---
# true = every PayPal write is simulated (still requires an approval record).
DEMO_MODE=false
# Assumptions used by the contest-vs-refund expected-value rule and the dashboard.
CHARGEBACK_FEE_USD=20
CONTEST_EFFORT_USD=10
# Global cap on LLM calls per UTC day. Over the cap, the app returns rule-based results.
LLM_DAILY_CAP=300

# --- Auth (single-merchant demo login) ---
DEMO_PASSWORD=change-me
# Generate with: openssl rand -base64 32   (or any random 16+ character string)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
